# Copia este archivo como ".env" (cp .env.example .env) y completa los valores.
# El archivo .env tiene secretos: NUNCA lo subas a GitHub (ya está en .gitignore).

# ── Obligatorio ──────────────────────────────────────────────
# Clave que firma los JWT (mínimo 32 caracteres). Genera una con:  openssl rand -base64 48
SGAD_JWT_SECRET=

# ── Dirección pública del sistema ────────────────────────────
# Local:     http://localhost          Servidor:  http://IP_DEL_SERVIDOR   o   https://tudominio.com
SGAD_FRONTEND_URL=http://localhost
SGAD_HTTP_PORT=80
# Con HTTPS poner true (la cookie de sesión solo viaja cifrada)
SGAD_COOKIE_SECURE=false

# ── Usuarios iniciales ───────────────────────────────────────
# Clase/demo: true crea admin, entrenador y deportista con claves de demostración.
# Servidor público: false y cambia la clave del admin.
SGAD_USUARIOS_DEMO=true
SGAD_ADMIN_PASSWORD=admin123

# ── Opcionales ───────────────────────────────────────────────
SGAD_JWT_EXPIRATION=3600
SGAD_SESSION_TIMEOUT=15m

# ── Login con Google (déjalos vacíos para desactivarlo) ──────
SGAD_GOOGLE_CLIENT_ID=
SGAD_GOOGLE_CLIENT_SECRET=

# En un servidor con Caddy/HTTPS delante: SGAD_BIND_IP=127.0.0.1 y SGAD_HTTP_PORT=8080 (así nadie entra por http://IP:8080)
SGAD_BIND_IP=0.0.0.0
